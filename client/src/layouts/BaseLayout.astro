---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
interface Props { title?:string; description?:string; ogImage?:string; noIndex?:boolean; }
const { title="Sudo Create | Software for creative people", description="A software development studio building apps, websites, and e-commerce for creative businesses and creative people.", ogImage="/og-image.svg", noIndex=false }=Astro.props;
const siteURL=Astro.site??new URL("https://sudocreate.studio");
const canonical=new URL(Astro.url.pathname,siteURL); const ogImageAbsolute=new URL(ogImage,siteURL);
const organization={"@context":"https://schema.org","@type":"ProfessionalService",name:"Sudo Create",url:siteURL.toString(),description,areaServed:"United States",knowsAbout:["Software development","Web development","Application development","E-commerce development"]};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#f1ede2"/>{noIndex&&<meta name="robots" content="noindex, nofollow"/>}<link rel="canonical" href={canonical}/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><meta property="og:type" content="website"/><meta property="og:site_name" content="Sudo Create"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImageAbsolute}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={ogImageAbsolute}/><script type="application/ld+json" set:html={JSON.stringify(organization)}/><title>{title}</title></head><body><Navigation/><main><slot/></main><footer class="site-footer"><div class="shell footer-grid"><div><a class="brand" href="/"><span class="brand-shield" aria-hidden="true">SUDO</span><span>Sudo Create</span></a><p class="fine-print">Useful software. Thoughtfully made.<br/>Tampa Bay roots, Midwest hospitality.</p></div><div class="footer-links"><strong>Shop talk</strong><a href="/work">Work</a><a href="/services">Services</a><a href="/about">About</a></div><div class="footer-links"><strong>Say hello</strong><a href="mailto:hello@sudocreate.studio">hello@sudocreate.studio</a><span class="fine-print">© {new Date().getFullYear()} Sudo Create</span></div></div></footer></body></html>
