---
import "../styles/global.css";
import DiscoveryCall from "../components/DiscoveryCall.astro";
import Navigation from "../components/Navigation.astro";
import TrackingPreferences from "../components/TrackingPreferences.astro";
import type { ServiceCategory } from "../lib/conversion";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  project?: string;
  classification?: string;
  service?: ServiceCategory;
}

const studioDescription = "Sudo Create is an independent Tampa Bay design and development studio building custom websites, applications, and digital experiences for businesses and founders.";
const {
  title = "Web Design & Custom App Development | Sudo Create",
  description = studioDescription,
  ogImage = "/og-image.jpg",
  noIndex = false,
  project,
  classification,
  service,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.sudocreate.studio");
const path = Astro.url.pathname;
const canonicalPath = path.endsWith("/") ? path : `${path}/`;
const canonical = new URL(canonicalPath, site);
const socialImage = new URL(ogImage, site);
const organization = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Sudo Create",
  url: site.toString(),
  description: studioDescription,
  logo: new URL("/sudo_black.png", site).toString(),
  areaServed: "United States",
  sameAs: ["https://www.instagram.com/shawnpaps/", "https://www.linkedin.com/in/shawn-papineau"],
  knowsAbout: ["Website design and development", "Application development", "E-commerce development"],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sudo Create" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, "\\u003c")} />
  </head>
  <body data-case-study={project} data-case-classification={classification} data-case-service={service}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navigation />
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href="/" aria-label="Sudo Create home">
            <img class="footer-logo" src="/sudo_white.png" width="653" height="517" alt="" loading="lazy" decoding="async" />
          </a>
          <p>Tampa Bay roots, Midwest hospitality.</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/work">Work</a>
          <a href="/services">Services</a>
          <a href="/about">About</a>
        </nav>
        <div class="footer-links">
          <DiscoveryCall placement="footer" />
          <a href="mailto:hello@sudocreate.studio">hello@sudocreate.studio</a>
          <div class="footer-social">
            <a href="https://www.instagram.com/shawnpaps/" target="_blank" rel="noreferrer">Instagram</a>
            <a href="https://www.linkedin.com/in/shawn-papineau" target="_blank" rel="noreferrer">LinkedIn</a>
          </div>
          <TrackingPreferences />
          <small>© {new Date().getFullYear()} Sudo Create</small>
        </div>
      </div>
    </footer>
    <script>
      import { initializeTracking } from "../lib/analytics";
      initializeTracking();
    </script>
  </body>
</html>
