---
import BaseLayout from "../layouts/BaseLayout.astro";
import { discoveryCall, projectTypes } from "../lib/conversion";

const destination = import.meta.env.PUBLIC_FORMSUBMIT_ID || "d6595365a14732679bc919542b4f5258";
if (!/^[a-f0-9]{32}$/i.test(destination)) {
  throw new Error("PUBLIC_FORMSUBMIT_ID must be the 32-character FormSubmit destination ID.");
}
---

<BaseLayout
  title="Request a Discovery Call | Sudo Create"
  description="Tell Shawn what you’re building. Share a brief website, custom application, or e-commerce project inquiry with Sudo Create."
>
  <section class="contact-section">
    <div class="shell contact-grid">
      <div class="contact-intro">
        <h1 class="display">Your next project starts with a conversation.</h1>
        <p>Building a new website, improving an existing one, or bringing an app idea to life? Tell me a little about it.</p>
        <p>I’ll reach out personally to talk through your goals and find a time to connect. A rough idea is plenty.</p>
        <p>No pressure. No obligation.</p>
      </div>
      <div class="contact-card">
        <form data-inquiry action={`https://formsubmit.co/${destination}`} method="POST" aria-label="Project inquiry">
          <input type="hidden" name="_subject" value="New Sudo Create project inquiry" />
          <input type="hidden" name="_captcha" value="false" />
          <div hidden><input type="text" name="_honey" tabindex="-1" autocomplete="off" /></div>
          <div class="form-grid">
            <div>
              <label for="name">Name</label>
              <input id="name" name="name" autocomplete="name" required />
            </div>
            <div>
              <label for="email">Email address</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label for="organization">Business <span>(optional)</span></label>
              <input id="organization" name="organization" autocomplete="organization" />
            </div>
            <div>
              <label for="kind">Project type</label>
              <select id="kind" name="project_type" required>
                <option value="">Choose a project type</option>
                {projectTypes.map(({ value, label }) => <option value={value}>{label}</option>)}
              </select>
            </div>
            <div class="field-full">
              <label for="budget">Working budget <span>(optional)</span></label>
              <select id="budget" name="budget">
                <option value="">Choose a budget if you have one</option>
                <option>Under $10k</option>
                <option>$10k–$25k</option>
                <option>$25k–$50k</option>
                <option>$50k+</option>
                <option>Let’s figure it out</option>
              </select>
            </div>
            <div class="field-full">
              <label for="message">Tell me a little about your project</label>
              <textarea id="message" name="message" rows="4" aria-describedby="message-hint" required></textarea>
              <p id="message-hint" class="field-hint">A few sentences about what you need or what’s getting in the way will do.</p>
            </div>
            <div class="field-full">
              <p class="form-error" data-form-error role="alert"></p>
              <button class="button button-primary" type="submit">{discoveryCall.label}</button>
              <p class="field-hint">You’ll hear directly from Shawn, the founder of Sudo Create.</p>
              <p class="field-hint contact-email">Prefer email? Write to <a class="text-link" href="mailto:hello@sudocreate.studio">hello@sudocreate.studio</a>.</p>
              <p class="sr-only" data-form-status role="status"></p>
            </div>
          </div>
        </form>
        <div data-inquiry-success hidden>
          <h2 class="display" tabindex="-1">Thanks for reaching out!</h2>
          <p>I’ve received your project inquiry and will be in touch personally to learn more about what you’re building and arrange a time to talk.</p>
          <p>Looking forward to it.<br />Shawn, Founder of Sudo Create</p>
          <a href="/work" class="text-link">Explore our work</a>
        </div>
      </div>
    </div>
  </section>
  <script>
    import { initializeInquiry } from "../lib/inquiry";
    initializeInquiry();
  </script>
</BaseLayout>
