---
import BaseLayout from "../layouts/BaseLayout.astro";
import InquirySection from "../components/InquirySection.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Website & Application Case Studies | Sudo Create" description="Explore client websites and founder-led software products designed and built by Sudo Create.">
  <header class="page-hero">
    <div class="shell">
      <h1 class="display">Useful things, well made.</h1>
      <p>Explore websites built for clients and applications developed in the studio. Each project started with a specific problem and the people who needed it solved.</p>
    </div>
  </header>
  <section class="section" aria-label="Projects"><div class="shell"><ProjectGrid projects={projects} headingLevel="h2" /></div></section>
  <InquirySection heading="The next one could be yours." placement="work-final">
    <p>Have a website that needs a rethink or an application you want to bring to life? Tell me what you’re working on.</p>
  </InquirySection>
</BaseLayout>
