---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientQuote from "../components/ClientQuote.astro";
import DiscoveryCall from "../components/DiscoveryCall.astro";
import { services } from "../lib/services";
---

<BaseLayout title="Website Design, Custom Apps & E-commerce | Sudo Create" description="Custom websites, applications, and Shopify storefronts designed and built by an independent Tampa Bay studio.">
  <header class="page-hero">
    <div class="shell">
      <h1 class="display">Websites, apps, and online stores.</h1>
      <p>Get a site that helps customers take the next step, or a tool that’s built around how your business works. You’ll work directly with Shawn from the first sketch through launch.</p>
    </div>
  </header>
  {services.map((service) => (
    <section class="section service-detail" id={service.id} data-service-view={service.id}>
      <div class="shell content-grid">
        <div>
          <h2 class="display">{service.headline}</h2>
          <p class="service-name">{service.name}</p>
        </div>
        <div>
          <p class="service-intro">{service.summary}</p>
          <ul class="list-plain" role="list">{service.capabilities.map((item) => <li>{item}</li>)}</ul>
          {service.projects.length > 0 && (
            <p class="related-work">See the work in {service.projects.map(({ id, name }, index) => (<>
              {index > 0 && (index === service.projects.length - 1 ? (index > 1 ? ", and " : " and ") : ", ")}<a class="text-link" href={`/work/${id}/`}>{name}</a>
            </>))}.</p>
          )}
          <DiscoveryCall placement="service-detail" service={service.id} />
          {service.id === "websites" && <ClientQuote id="kristen-m" />}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
