---
import BaseLayout from "../layouts/BaseLayout.astro";
import FounderPortrait from "../components/FounderPortrait.astro";
import ClientQuote from "../components/ClientQuote.astro";
import CustomerReferences from "../components/CustomerReferences.astro";
import DiscoveryCall from "../components/DiscoveryCall.astro";
import FrequentlyAsked from "../components/FrequentlyAsked.astro";
import InquirySection from "../components/InquirySection.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import ServiceOverview from "../components/ServiceOverview.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);

const differences = [
  ["Work directly with Shawn", "The person you meet on the first call is the person designing and building your project through launch."],
  ["Design and engineering under one roof", "Design decisions and technical decisions happen together, so how the product looks supports how it works."],
  ["Built around your business", "We start with your goals, your customers, and the problem you need to solve. Those conversations shape what we build."],
  ["Straightforward communication", "You’ll know what’s in progress, which decisions need your input, and what comes next."],
  ["Care you can see and use", "The details matter, from how clearly a page reads to how easily you can maintain the software after it launches."],
];

const process = [
  ["Discover", "We talk about your business, your goals, and what the website or app needs to do. A rough idea is plenty to get started."],
  ["Design", "We lay out the structure, user experience, and visual direction. You’ll review the direction before development moves forward."],
  ["Develop", "We turn the approved design into a working site or app, with attention to usability, accessibility, performance, and maintainability."],
  ["Launch", "We test, refine, and launch. You’ll know how to use what we built and have a clear picture of what comes next."],
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <h1 class="display">Better websites.<br />Smarter apps.<span>Built around your business.</span></h1>
        <p class="hero-copy">Sudo Create designs and builds custom websites and applications for businesses and founders who need more than an off-the-shelf solution.</p>
        <div class="hero-actions">
          <DiscoveryCall placement="home-hero" />
          <a class="button button-secondary" href="/work">Explore our work</a>
        </div>
        <p class="cta-note">Tell me what you’re building. I’ll personally be in touch.</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="work-ticket">
          <svg viewBox="0 0 360 270" fill="none">
            <g stroke="currentColor" stroke-width="3" stroke-linejoin="round">
              <rect x="23" y="30" width="268" height="169" class="art-paper"/>
              <path d="M23 63h268M36 47h6m9 0h6m9 0h6" stroke-linecap="round"/>
              <path d="M46 83h101v72H46z" class="art-accent"/>
              <path d="m46 147 31-30 19 14 26-31 25 23M46 174h88m34-85h97m-97 19h64m-64 19h46" stroke-linecap="round"/>
              <rect x="225" y="111" width="88" height="126" class="art-paper"/>
              <path d="M237 127h64v43h-64z" class="art-accent"/>
              <path d="M237 185h53m-53 13h41m-41 20h26" stroke-linecap="round"/>
              <path d="M23 221h168m-168 17h109" stroke-dasharray="3 7" opacity=".55"/>
              <path d="M318 41c16-19 28-13 21 0-7 12-24 13-16-2m-6 18 23 10m-31-3 7 14" stroke-linecap="round" class="art-mark"/>
            </g>
          </svg>
          <div class="punches">{Array.from({ length: 9 }, () => <i></i>)}</div>
        </div>
      </div>
    </div>
  </section>
  <div class="proof-strip"><div class="shell"><ClientQuote id="kristen-m" /></div></div>
  <ServiceOverview />
  <section class="section">
    <div class="shell">
      <h2 class="display section-title">Good work, built with purpose.</h2>
      <ProjectGrid projects={projects} />
    </div>
  </section>
  <section class="section differentiation">
    <div class="shell content-grid">
      <div>
        <h2 class="display">A creative partner who knows how to build.</h2>
        <p>Good software should feel like a familiar tool. Easy to pick up, dependable when the work gets real, and unmistakably yours.</p>
      </div>
      <div class="editorial-list">
        {differences.map(([title, copy]) => <div><h3>{title}</h3><p>{copy}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <h2 class="display section-title">Good work starts with a good conversation.</h2>
      <ol class="process-grid" role="list">
        {process.map(([name, description], index) => (
          <li class="process-card">
            <h3><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span> {name}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section founder-section">
    <div class="shell founder-grid">
      <FounderPortrait />
      <div class="founder-copy">
        <h2 class="display">Small studio. Full attention.</h2>
        <p>I’m Shawn, the founder of Sudo Create. My background spans software engineering, design, and creative production. I bring those disciplines together to make websites and applications that feel considered and work reliably.</p>
        <p>I care about getting to know the people I’m building for, making the details count, and taking pride in what goes out the door.</p>
        <a class="button button-secondary" href="/about">Meet the founder</a>
      </div>
    </div>
  </section>
  <CustomerReferences />
  <FrequentlyAsked />
  <InquirySection heading="Your next project starts with a conversation." placement="home-final" orange>
    <p>Have a website that isn’t doing its job? An app idea you’ve been sitting on? Something your business needs but can’t find off the shelf?</p>
    <p>Let’s figure out what we can build together.</p>
    <p class="cta-note">Tell me a little about your project, and I’ll personally be in touch.</p>
  </InquirySection>
</BaseLayout>
