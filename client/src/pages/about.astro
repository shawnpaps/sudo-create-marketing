---
import BaseLayout from "../layouts/BaseLayout.astro";
import FounderPortrait from "../components/FounderPortrait.astro";
import InquirySection from "../components/InquirySection.astro";
---
<BaseLayout title="Meet Shawn Papineau | Sudo Create" description="Meet Shawn Papineau, founder of Sudo Create, an independent Tampa Bay website design and custom application development studio.">
  <header class="page-hero">
    <div class="shell">
      <h1 class="display">Creative instincts. Working-class follow-through.</h1>
      <p>Sudo Create is an independent design and development studio for people who care about how things work and how they feel.</p>
    </div>
  </header>
  <section class="section">
    <div class="shell founder-grid">
      <FounderPortrait />
      <div class="founder-copy">
        <h2 class="display">Consider me your neighbor in software.</h2>
        <p>I’m Shawn. I started Sudo Create to give businesses and founders the kind of technical partnership I always wanted. Someone who listens, explains the work clearly, and takes responsibility for how it turns out.</p>
        <p>My background spans music, media, design, and software engineering. That mix helps me translate an idea into a website or application that people can actually use. When you work with the studio, you work directly with me from the first conversation through launch.</p>
        <p>I bring a little Midwest hospitality to my work in Tampa Bay. I show up prepared, make the complicated understandable, and take care of the details you’ve entrusted to me.</p>
        <a class="button button-secondary" href="/services">Explore our services</a>
      </div>
    </div>
  </section>
  <InquirySection heading="Let’s talk about what you’re building." placement="about-final">
    <p>Tell me where you’re starting and what you’d like to make possible. We can figure out the next step together.</p>
  </InquirySection>
</BaseLayout>
