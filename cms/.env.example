# Neon pooled connection string. Add sslmode=require when your copied Neon URL does not include it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Generate a long random value for production.
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Canonical CMS URL on Vercel.
SERVER_URL=http://localhost:3000

# Comma-separated frontend origins allowed to call Payload.
CORS_ORIGINS=http://localhost:4321,https://sudocreate.studio

# Added automatically when a Vercel Blob store is connected to the CMS project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
